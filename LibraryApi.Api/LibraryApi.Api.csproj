    <UserSecretsId>d7a07502-ca00-42da-bf89-67e26b3f564f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
